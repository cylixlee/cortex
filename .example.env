# Chat Model
CHAT_PROVIDER="<Your model provider>"
CHAT_BASE_URL="<Your model provider's API base URL>"
CHAT_API_KEY="<Your API Key>"
CHAT_MODEL="<Your model name>"

# Database
#
# This URL is definite since we've used Docker Compose to create the postgres container. You can change the
# docker-compose.yml to choose different user, password or db. Make sure the URL here is changed accordingly.
DATABASE_URL="postgres://cortex:cortex_secret@localhost:5432/cortex?sslmode=disable"

# JWT Auth
JWT_SECRET="<Your JWT secret>"
JWT_EXPIRY_HOURS=24

# MinIO Object Storage
#
# If you change the user, password or port in docker-compose.yml, make sure to update here accordingly.
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="cortex-skills"
MINIO_USE_SSL=false

# Redis
#
# If you change the port in docker-compose.yml, make sure to update here accordingly.
REDIS_URL="redis://localhost:6379"

# Embedding
EMBEDDING_PROVIDER="<Embedding provider>"
EMBEDDING_BASE_URL="<Embedding API base URL>"
EMBEDDING_API_KEY="<Your embedding API key>"
EMBEDDING_MODEL="<Embedding model name>"
